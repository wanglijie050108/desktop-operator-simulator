{
  "name": "@hos/control-server",
  "version": "0.1.0",
  "private": true,
  "description": "Task orchestration and policy service.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "@hos/contracts": "0.1.0",
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "tsx": "4.23.15",
    "vitest": "5.0.1",
    "ws": "8.21.3"
  }
}
